# ============================================================
# REQUIRED
# ============================================================

# Discord webhook URL (get from Server Settings → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=

# Secret token to protect /api/daily-brief and /api/test-discord
# Use a strong random string, e.g.: openssl rand -hex 32
CRON_SECRET=

# ============================================================
# AI — Required for Claude Haiku analysis
# If missing, system runs in rule-based fallback mode
# ============================================================

ANTHROPIC_API_KEY=

# Default model (current active Haiku). Override only if needed.
# ANTHROPIC_MODEL=claude-haiku-5-5

# ============================================================
# NEWS — OPTIONAL (development/testing only)
# Production runs entirely on RSS feeds — NewsAPI not required
# ============================================================

# NEWS_API_KEY=

# ============================================================
# TUNING — Optional (defaults shown)
# ============================================================

# MAX_AI_ARTICLES=20
# MAX_SNIPPET_CHARS=2500
# MAX_TOTAL_INPUT_CHARS=40000
# MAX_OUTPUT_TOKENS=8000
# AI_TIMEOUT_MS=30000
